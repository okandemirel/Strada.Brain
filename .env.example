# --- Rate limits & budget ---
# With RATE_LIMIT_ENABLED=true, a RATE_LIMIT_* limit left unset uses the
# built-in default (no message limits, 500000 tokens/day, $5/day, $100/month);
# an explicit 0 means unlimited. Spend caps count from the daemon.db ledger, so
# a restart does not reset them.
# RATE_LIMIT_DAILY_BUDGET_USD=
# RATE_LIMIT_ENABLED=
# RATE_LIMIT_MESSAGES_PER_HOUR=
# RATE_LIMIT_MESSAGES_PER_MINUTE=
# RATE_LIMIT_MONTHLY_BUDGET_USD=
# RATE_LIMIT_TOKENS_PER_DAY=
# STRADA_BUDGET_DAILY_USD=
# STRADA_BUDGET_MONTHLY_USD=
# STRADA_BUDGET_WARN_PCT=
# Headroom (USD) a task run reserves at start when it has no estimate of its
# own (default 0.25; 0 disables), and a live override for the interactive
# token budget (unset: TASK_INTERACTIVE_TOKEN_BUDGET applies).
# STRADA_BUDGET_TASK_RESERVATION_USD=
# STRADA_INTERACTIVE_TOKEN_BUDGET=

