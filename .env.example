# =============================================================================
# Strada.Brain environment configuration
# Copy to .env and fill in:  cp .env.example .env
#
# REQUIRED: at least ONE AI provider API key below (or configure Ollama via
# OLLAMA_BASE_URL / OLLAMA_MODEL). Everything else is optional or only
# required when the corresponding feature/channel is enabled.
# =============================================================================

# --- AI Providers (at least one required; Ollama needs no key) ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
TOGETHER_API_KEY=

# --- AI Providers — auth modes, per-provider model overrides, chain, preset, Ollama, OpenCode (all optional) ---
# ANTHROPIC_AUTH_MODE=
# ANTHROPIC_AUTH_TOKEN=
# CLAUDE_MODEL=
# OPENROUTER_MODEL=
# OPENAI_AUTH_MODE=
# OPENAI_CHATGPT_AUTH_FILE=
# Codex CLI home; the default ChatGPT/Codex auth file is read from here when set.
# CODEX_HOME=
# OPENAI_MODEL=
# OPENAI_SUBSCRIPTION_ACCESS_TOKEN=
# OPENAI_SUBSCRIPTION_ACCOUNT_ID=
# GEMINI_MODEL=
# DEEPSEEK_MODEL=
# QWEN_MODEL=
# KIMI_MODEL=
# MINIMAX_MODEL=
# GROQ_MODEL=
# MISTRAL_MODEL=
# TOGETHER_MODEL=
# FIREWORKS_MODEL=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=
# OPENCODE_DEFAULT_MODEL=
# OpenCode tuning: context window in tokens (default 128000, min 8192), max
# output tokens (default 16384), first-response timeout in ms, and reasoning
# effort (default low).
# OPENCODE_CONTEXT_WINDOW=
# OPENCODE_FIRST_RESPONSE_TIMEOUT_MS=
# OPENCODE_MAX_TOKENS=
# OPENCODE_REASONING_EFFORT=
# Second and third OpenCode accounts ("opencode2", "opencode3" in PROVIDER_CHAIN).
# OPENCODE2_API_KEY=
# OPENCODE2_BASE_URL=
# OPENCODE2_DEFAULT_MODEL=
# OPENCODE3_API_KEY=
# OPENCODE3_BASE_URL=
# OPENCODE3_DEFAULT_MODEL=
# PROVIDER_CHAIN=
# PROVIDER_CHAIN_STRICT=1 makes PROVIDER_CHAIN the whole chain: no fallback
# providers are appended automatically. Default: false.
# PROVIDER_CHAIN_STRICT=
# Max simultaneous in-flight calls per provider (default 3), and a minimum gap
# between calls to one provider in ms (default 0) for accounts needing pacing.
# PROVIDER_MAX_CONCURRENT_REQUESTS=
# PROVIDER_MIN_REQUEST_INTERVAL_MS=
# SYSTEM_PRESET=

# --- Channels — Web, Telegram, Discord, Slack, Teams ---
# Credentials are required only when the corresponding channel is enabled
# (TELEGRAM_BOT_TOKEN, DISCORD_BOT_TOKEN, SLACK_BOT_TOKEN + SLACK_SIGNING_SECRET,
#  TEAMS_APP_ID + TEAMS_APP_PASSWORD).
# WEB_CHANNEL_PORT=
# TELEGRAM_BOT_TOKEN=
# ALLOWED_TELEGRAM_USER_IDS=
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# ALLOWED_DISCORD_ROLE_IDS=
# ALLOWED_DISCORD_USER_IDS=
# SLACK_APP_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_SOCKET_MODE=
# Port of Slack's HTTP receiver when SLACK_SOCKET_MODE=false; it binds BIND_HOST.
# Default 3000 — the web channel's default too, so pick another when running both.
# SLACK_HTTP_PORT=
# ALLOWED_SLACK_USER_IDS=
# ALLOWED_SLACK_WORKSPACES=
# TEAMS_ALLOW_OPEN_ACCESS=
# TEAMS_ALLOWED_USER_IDS=
# TEAMS_APP_ID=
# TEAMS_APP_PASSWORD=
# TEAMS_APP_TYPE=
# TEAMS_APP_TENANT_ID=
# Port of the Bot Framework webhook listener; it binds BIND_HOST. Default 3978.
# TEAMS_PORT=

# --- Security (all optional) ---
# JWT_SECRET and REQUIRE_MFA configure an auth module no channel uses yet: they
# protect nothing today (SECURITY.md, section 13).
# JWT_SECRET=
# READ_ONLY_MODE=
# REQUIRE_EDIT_CONFIRMATION=
# REQUIRE_MFA=

# --- Unity / Strada ---
# UNITY_PROJECT_PATH is required by config validation and must point to an
# existing directory (your Unity project). The rest are optional.
# STRADA_CORE_REPO_URL=
# STRADA_MCP_PATH=
# Strada.MCP runs inside the Brain process. A copy inside the Unity project
# (e.g. the Packages/Submodules/Strada.MCP submodule setup installs) is
# agent-writable, so it is only loaded when you trust it explicitly:
# STRADA_MCP_ALLOW_PROJECT_LOCAL=true. Otherwise keep Strada.MCP outside the
# project (sibling checkout or STRADA_MCP_PATH). Default: false.
# STRADA_MCP_ALLOW_PROJECT_LOCAL=
# STRADA_MCP_REPO_URL=
# STRADA_MODULES_REPO_URL=
# UNITY_BRIDGE_AUTO_CONNECT=
# UNITY_BRIDGE_PORT=
# UNITY_BRIDGE_TIMEOUT=
# UNITY_EDITOR_PATH=
# UNITY_PATH=
UNITY_PROJECT_PATH=
# Unity Editor binary for Asset Store / Unity Link tasks (UNITY_EDITOR_PATH is
# also read), their project when UNITY_PROJECT_PATH is unset, and the Unity CLI
# path override.
# STRADA_UNITY_BIN=
# STRADA_UNITY_PROJECT=
# STRADA_UNITY_CLI=
# Where local open-weights asset models live. Default: ~/.strada/assets-local.
# STRADA_ASSETS_LOCAL_ROOT=

# --- External MCP servers ---
# The server list is a JSON file, not an env var: each entry has its own
# command, args and credentials, which do not survive being flattened into a
# shell variable. Defaults to ~/.strada/mcp.json. Both shapes are accepted:
#
#   { "mcpServers": { "files": { "command": "npx", "args": ["-y", "mcp-server-filesystem", "/path"] } } }
#   [ { "name": "files", "command": "npx", "args": ["-y", "mcp-server-filesystem", "/path"] } ]
#
# Tools arrive namespaced as mcp__<server>__<tool>. An MCP server is an ordinary
# executable running with Strada's privileges — there is no sandbox — but it does
# NOT inherit this process's environment, so put any credential it needs in that
# server's own "env" object rather than expecting it to be picked up from here.
# MCP_CONFIG_PATH=

# --- Obsidian vault (required only when the Obsidian integration is enabled) ---
# OBSIDIAN_API_KEY=
# OBSIDIAN_API_URL=
# OBSIDIAN_CERT_PATH=
# OBSIDIAN_ENABLED=
# OBSIDIAN_VAULT_PATH=
# STRADA_VAULT_DEBOUNCE_MS=
# STRADA_VAULT_EMBEDDING_FALLBACK=
# STRADA_VAULT_ENABLED=
# STRADA_VAULT_SELF_ENABLED=
# STRADA_VAULT_WRITE_HOOK_BUDGET_MS=

# --- Listeners ---
# Address the web channel, dashboard, WebSocket dashboard and Prometheus
# exporter bind to. Default 127.0.0.1 (local only); use 0.0.0.0 in a container.
# BIND_HOST=
# Hostnames those listeners (and the setup wizard) answer for besides localhost
# and IP literals, comma-separated: a bare name trusts every port, host:port
# exactly one. A request whose Host header names anything else is refused
# (DNS-rebinding protection). Behind a reverse proxy that forwards Host, list
# the public hostname; WEB_TRUSTED_ORIGINS hostnames are served by the portal.
# HTTP_ALLOWED_HOSTS=
# Extra origins the web portal accepts for its WebSocket and mutating requests,
# comma-separated (e.g. https://brain.example.com behind a reverse proxy).
# Unset: only the portal's own bound origin.
# WEB_TRUSTED_ORIGINS=

# --- Dashboard / WebSocket / Prometheus ---
# DASHBOARD_ENABLED=
# DASHBOARD_PORT=
# ENABLE_PROMETHEUS=
# ENABLE_WEBSOCKET_DASHBOARD=
# PROMETHEUS_PORT=
# STRADA_DASHBOARD_HISTORY_DEPTH=
# WEBSOCKET_DASHBOARD_ALLOWED_ORIGINS=
# WEBSOCKET_DASHBOARD_AUTH_TOKEN=
# WEBSOCKET_DASHBOARD_PORT=

