# Per-attempt first-response timeout (ms) for the provider fallback chain: how long a
# provider may stay silent before the chain aborts it, fails over, and (after repeated
# strikes) auto-demotes the model from the global default. Default 90000 (90s).
# LLM_PROVIDER_FIRST_RESPONSE_TIMEOUT_MS=
# LLM_STREAM_INITIAL_TIMEOUT_MS=
# LLM_STREAM_STALL_TIMEOUT_MS=
