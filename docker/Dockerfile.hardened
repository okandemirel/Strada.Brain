# Hardened Dockerfile for Strada.Brain
# 
# Security Features:
# - Non-root user
# - Read-only filesystem
# - Minimal base image
# - Multi-stage build
# - Security scanning
# - Health checks

# =============================================================================
# STAGE 1: Dependencies
# =============================================================================
# These are the dependencies the BUILD runs with, so they include
# devDependencies: `npm run build` runs tsc and vite, both devDependencies.
# The previous production-only install stripped them and the build stage
# then failed on the first line it ran. Production-only node_modules are
# produced by pruning after the build (STAGE 2), not by installing less here.
#
# --ignore-scripts is also gone: better-sqlite3 is a native module and its
# install script is what produces the binding. Skipping it left an image whose
# every SQLite-backed subsystem threw on first use. The build toolchain below
# is what lets that native build succeed on Alpine.
FROM node:20-alpine AS deps

# Install security updates and the toolchain native modules need
RUN apk update && \
    apk upgrade && \
    apk add --no-cache \
        ca-certificates \
        dumb-init \
        python3 \
        make \
        g++ \
        libc-dev \
        linux-headers && \
    rm -rf /var/cache/apk/*

# Create app directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (devDependencies included — the build needs them)
RUN npm ci --include=dev && \
    npm cache clean --force && \
    rm -rf /root/.npm /root/.node-gyp /tmp/*

# Portal dependencies come from web-portal's own lockfile
COPY web-portal/package.json web-portal/package-lock.json ./web-portal/
RUN npm ci --prefix web-portal && \
    npm cache clean --force

# =============================================================================
# STAGE 2: Build
# =============================================================================
FROM deps AS builder

WORKDIR /app

COPY package*.json ./
COPY tsconfig.json ./

# Copy source code. `npm run build` IS `node scripts/build-package.mjs`, which
# also builds web-portal/ and copies the bundle into dist/channels/web/static,
# so both directories are part of the build context.
COPY scripts ./scripts
COPY web-portal ./web-portal
COPY src ./src

# Build TypeScript + web portal
RUN npm run build

# Drop devDependencies so the runtime stage below copies a production tree
RUN npm prune --omit=dev && \
    npm cache clean --force

# =============================================================================
# STAGE 3: Production
# =============================================================================
FROM node:20-alpine AS production

# Security labels
LABEL maintainer="Strada.Brain Team"
LABEL security.scan="enabled"
LABEL security.readonly-rootfs="true"
LABEL security.non-root="true"

# Install security updates and required packages
RUN apk update && \
    apk upgrade && \
    apk add --no-cache \
        ca-certificates \
        dumb-init \
        tzdata && \
    rm -rf /var/cache/apk/* && \
    # Create non-root user
    addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Set working directory
WORKDIR /app

# Copy production dependencies. They come from `builder` (pruned after the
# build) and NOT from `deps`, which by design still carries devDependencies.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
# Ops and runtime scripts — `npm run <script>` inside the container needs them.
COPY --from=builder /app/scripts ./scripts
COPY package*.json ./

# Create necessary directories with proper permissions
RUN mkdir -p /app/logs /app/data /app/tmp && \
    chown -R nodejs:nodejs /app && \
    chmod -R 755 /app && \
    chmod 1777 /app/tmp

# Set environment variables
ENV NODE_ENV=production
ENV PORT=3000
ENV USER=nodejs
ENV HOME=/app

# Security environment variables
ENV READ_ONLY_MODE=true
ENV SHELL_ENABLED=false
ENV RATE_LIMIT_ENABLED=true

# Remove unnecessary tools
RUN apk del curl wget 2>/dev/null || true && \
    rm -rf /usr/bin/curl /usr/bin/wget /usr/bin/nc /bin/nc

# Switch to non-root user
USER nodejs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Use dumb-init as PID 1 for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start application
CMD ["node", "dist/index.js"]

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# 
# Run with these security options:
#
# docker run -d \
#   --read-only \
#   --security-opt=no-new-privileges:true \
#   --cap-drop=ALL \
#   --cap-add=NET_BIND_SERVICE \
#   --user=1001:1001 \
#   --tmpfs /app/tmp:noexec,nosuid,size=100m \
#   -p 3000:3000 \
#   strada-brain:hardened
#
# =============================================================================
