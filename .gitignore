node_modules/
dist/
web-portal/dist/
.env
# Every variant, not just the exact name. Two backups of .env — .env.bak.191546
# and .env.backup-loglevel — were tracked and pushed with a live API key in
# them, because the rule above matches one filename and a backup is never
# called that.
.env.*
!.env.example
*.log
*.tsbuildinfo
.DS_Store
*.sqlite
*.sqlite-journal
*.bak
.vscode/
.idea/
coverage/
.worktrees/
.planning/
.kimi/
.strada-memory/
.strada/
*.tgz

# Local AI/editor agent state and tool metadata
.agents/
.claude/
.codex/
.cursor/
!.cursor/rules/
.roo/
.windsurf/
!.windsurf/rules/
.opencode/
.continue/
.qodo/
.kiro/
.augment/
.aider*

# The web portal build output is mirrored into dist/channels/web/static; the
# servers fall back to it (see src/common/web-static-dir.ts). Only a self-contained
# placeholder index.html is tracked here as the unbuilt fallback — built assets
# (assets/, hashed bundles) are git-ignored so a stale build can never shadow the
# real one.
src/channels/web/static/*
!src/channels/web/static/index.html
# Generated benchmark artifacts. The corpus is regenerated deterministically
# from scripts/bench/make-corpus.mjs, but manifest.json (its content hash) and
# the recorded baselines MUST be committed — the gate compares against them.
benchmarks/.report.json
benchmarks/corpus/unity-synth-v1-*/
