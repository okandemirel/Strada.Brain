# The web portal build output is mirrored into dist/channels/web/static; the
# servers fall back to it (see src/common/web-static-dir.ts). Only a self-contained
# placeholder index.html is tracked here as the unbuilt fallback — built assets
# (assets/, hashed bundles) are git-ignored so a stale build can never shadow the
# real one.
src/channels/web/static/*
!src/channels/web/static/index.html
